APP_NAME=Smart Study Assistant API
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/smart_study_assistant

JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=30

CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=250

RAG_TOP_K=5
RAG_MIN_SCORE=0.05

AI_PROVIDER=openai_compatible
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=

AI_CHAT_MODEL=qwen3:8b
AI_EMBEDDING_MODEL=embeddinggemma
AI_TIMEOUT_SECONDS=300

OCR_ENABLED=true
OCR_LANGUAGES=vie+eng
OCR_DPI=200
OCR_PAGE_MIN_CHARS=30

TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata
